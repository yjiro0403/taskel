<?xml version="1.0" encoding="utf-8"?>
<!--
  ホーム画面ウィジェット「今日の予定」のメタデータ。
  - 4x3 セルを標準サイズにし、縦横ともにリサイズ可（最小 3x2）
  - updatePeriodMillis は保険の定期再描画（最小の 30 分）。主な再描画は
    Web からの同期と、行の切り替え時刻に予約する AlarmManager で行う
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_schedule"
    android:previewLayout="@layout/widget_schedule"
    android:description="@string/widget_schedule_description"
    android:widgetCategory="home_screen" />
