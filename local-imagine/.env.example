# These values only seed data/settings.json on the first start; afterwards edit them in the Settings dialog.
# Where Ollama is listening (default install)
OLLAMA_URL=http://127.0.0.1:11434
# Where ComfyUI is listening (default: python main.py --listen 127.0.0.1 --port 8188)
COMFYUI_URL=http://127.0.0.1:8188
# Folder for personas / chats / generated images (relative to local-imagine/)
DATA_DIR=./data
