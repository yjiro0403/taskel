      "scope": "tasks:create",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "day": {
            "type": "string",
            "enum": [
              "today",
              "tomorrow"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "scheduled_start": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{16,64}$"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "example": {
        "request": {
          "title": "請求書を送る",
          "day": "today",
          "scheduled_start": "10:00",
