    {
      "name": "taskel_search_tasks",
      "scope": "tasks:read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "range": {
            "type": "string",
            "enum": [
              "today",
              "yesterday",
              "this_week",
              "last_week",
              "last_7_days",
              "last_30_days",
              "last_90_days",
              "this_month",
              "last_month"
            ]
          },
          "date_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "open",
                "in_progress",
                "done"
              ]
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          },
          "include_undated": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "example": {
        "request": {
          "query": "請求書",
          "range": "last_week"
